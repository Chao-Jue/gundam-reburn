{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "status",
    "repository",
    "branch",
    "commit",
    "issue",
    "pr",
    "summary",
    "changed_files",
    "acceptance",
    "verification",
    "findings",
    "remaining",
    "next_steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "operation": {
      "enum": [
        "issue",
        "implementation",
        "pr",
        "review",
        "merge",
        "release",
        "handoff"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "partial"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "issue": {
      "type": [
        "integer",
        "null"
      ]
    },
    "pr": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "status",
          "command",
          "exit_code",
          "evidence"
        ],
        "properties": {
          "level": {
            "enum": [
              "source_inspection",
              "compile_build",
              "automated_tests",
              "service_startup",
              "database_migration",
              "runtime_integration",
              "native_client_e2e"
            ]
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run",
              "not_applicable"
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "path",
          "line",
          "problem",
          "evidence",
          "requested_change"
        ],
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "problem": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "requested_change": {
            "type": "string"
          }
        }
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
